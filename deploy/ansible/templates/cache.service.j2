[Unit]
Description=Tianlai cache node {{ tianlai_server_id }}
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ tianlai_root }}/src/{{ tianlai_profile }}
ExecStart={{ tianlai_root }}/bin/tianlai-store-{{ tianlai_profile | lower }} {{ tianlai_root }}/config/server.yaml {{ tianlai_root }}/config/recv.yaml
ExecStopPost=/usr/local/sbin/tianlai-rebind-ixgbe $SERVICE_RESULT {{ tianlai_receive_devices | join(' ') }}
Restart=on-failure
RestartSec=5
KillSignal=SIGKILL
LimitCORE=0
MemorySwapMax=0
LogsDirectory=tianlai
LogsDirectoryMode=0755
UMask=0022

[Install]
WantedBy=multi-user.target
