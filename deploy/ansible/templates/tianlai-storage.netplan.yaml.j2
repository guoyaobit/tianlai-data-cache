# Managed by Ansible. Local changes will be overwritten.
network:
  version: 2
  ethernets:
    "{{ tianlai_storage_receive_interface }}":
      renderer: NetworkManager
      mtu: {{ tianlai_jumbo_mtu }}
      dhcp4: false
      optional: true
      addresses:
        - "{{ tianlai_storage_ip }}/{{ tianlai_storage_prefix_length }}"
