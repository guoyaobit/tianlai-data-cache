# Cache-node network, NIC, and logging settings.
SERVERID: {{ tianlai_server_id | int }}  # Unique cache node ID (0-13).
controlBindIp: {{ tianlai_control_ip | to_json }}  # Local management IP for control commands.
controlPeerIp: {{ tianlai_controller_ip | to_json }}  # Controller IP allowed to send commands.
controlPort: {{ tianlai_control_port | int }}  # Local management TCP/JSON control port.
logFilePath: "-"  # Log path; "-" writes only to stderr.
{% for device in tianlai_receive_devices %}
deviceName{{ loop.index0 }}: {{ device | to_json }}  # ixcap PCI address for this receive port.
cpuId{{ loop.index0 }}: -1  # Receive-thread CPU ID; -1 disables affinity.
{% endfor %}
sendEthName: {{ tianlai_send_interface | to_json }}  # Both logical lanes share this physical storage-network interface.
sendSourceIp: {{ tianlai_send_ip | to_json }}
sendDestinationIp: {{ tianlai_storage_ip | to_json }}
sendDestinationPort0: {{ (tianlai_storage_port | int) + (tianlai_server_id | int) }}  # Logical lane ports on the same physical link.
sendDestinationPort1: {{ (tianlai_storage_lane1_port | int) + (tianlai_server_id | int) }}
