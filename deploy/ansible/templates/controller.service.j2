[Unit]
Description=Tianlai trigger controller
After=network-online.target tianlai-storage.service
Wants=network-online.target tianlai-storage.service

[Service]
Type=simple
WorkingDirectory={{ tianlai_root }}/tools
ExecStart=/usr/bin/python3 {{ tianlai_root }}/tools/controller.py --nodes {{ tianlai_root }}/config/nodes.json --acquisition {{ tianlai_acquisition_id }} --journal {{ tianlai_root }}/journal --bind {{ tianlai_controller_ip }} --port {{ tianlai_controller_port }} --allow-source {{ tianlai_backend_ip }} --period-us {{ tianlai_period_us }} --integration-per-trace {{ tianlai_integration_per_trace }}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
