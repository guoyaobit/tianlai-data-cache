# Managed by Ansible. Local changes will be overwritten.
network:
  version: 2
  ethernets:
{% for interface in tianlai_receive_netplan_interfaces %}
    "{{ interface }}":
      renderer: NetworkManager
      mtu: {{ tianlai_jumbo_mtu }}
      dhcp4: false
      dhcp6: false
      accept-ra: false
      link-local: []
      optional: true
{% endfor %}
{% if not tianlai_receive_netplan_interfaces %}
    {}
{% endif %}
