# Managed by Ansible. Local changes will be overwritten.
network:
  version: 2
  ethernets:
    "{{ tianlai_send_interface }}":
      renderer: NetworkManager
      mtu: {{ tianlai_jumbo_mtu }}
      dhcp4: false
      optional: true
      addresses:
        - "{{ tianlai_send_ip }}/{{ tianlai_cache_send_prefix_length }}"
